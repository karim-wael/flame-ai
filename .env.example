# FLARE AI — Environment Configuration Template
# Copy this file to .env and backend/.env and fill in your credentials.
# NEVER commit real API keys or database credentials to Git.

# Database Configuration (PostgreSQL with pgvector recommended for production; defaults to local SQLite fallback for instant dev)
DATABASE_URL=sqlite:///./flare_ai.db
# Example PostgreSQL URL (matching docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://flare_user:flare_password@localhost:5432/flare_ai

# AI / LLM Configuration (Optional — Core data pipeline, explorer, and similarity engine run independently of LLM)
GEMINI_API_KEY=your_gemini_or_vertex_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-2.5-flash

# Security & Ingestion Authorization
INGESTION_API_TOKEN=flare-dev-ingestion-token-2026

# Frontend Public API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
